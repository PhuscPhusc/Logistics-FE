
@inject UserAdminServices userServices;
@inject NavigationManager navManager;

<div class="d-none d-lg-block bg-light" style="width:250px; height:100vh;">
  <div class="p-3 fw-bold text-danger border-bottom">viettel post</div>

  <div class="list-group list-group-flush">
    <!-- Trang chủ -->
    <a class="list-group-item list-group-item-action d-flex align-items-center" href="/customerhomepage">
      <span class="flex-grow-1"><i class="fas fa-user"></i> Thông tin cá nhân</span>
      <span class="text-end"><i class="fas fa-home"></i></span>
    </a>


    @* <!-- Người dùng -->
    <a class="list-group-item list-group-item-action d-flex align-items-center" data-bs-toggle="collapse"
       href="#submenuUser" role="button" aria-expanded="false" aria-controls="submenuUser">
      <span class="flex-grow-1"><i class="fas fa-user"></i> Người dùng</span>
      <span class="text-end"><i class="fas fa-chevron-circle-down"></i></span>
    </a>
    <div class="collapse" id="submenuUser">
      <div class="list-group list-group-flush ms-4">
        <a href="/users" class="list-group-item list-group-item-action">Danh sách người dùng</a>
        <a href="/addnewuser" class="list-group-item list-group-item-action">Thêm người dùng</a>
      </div>
    </div> *@

    <!-- Đơn vận chuyển -->
    <a class="list-group-item list-group-item-action d-flex align-items-center" data-bs-toggle="collapse"
       href="#submenuUser" role="button" aria-expanded="false" aria-controls="submenuUser">
      <span class="flex-grow-1"><i class="fas fa-user"></i> Đơn vận chuyển</span>
      <span class="text-end"><i class="fas fa-chevron-circle-down"></i></span>
    </a>
    <div class="collapse" id="submenuUser">
      <div class="list-group list-group-flush ms-4">
        <a href="/shipment" class="list-group-item list-group-item-action">Danh sách đơn vận chuyển</a>
        <a href="/createshipment" class="list-group-item list-group-item-action">Tạo mới đơn vận chuyển</a>
        <a href="/shipmenthistory" class="list-group-item list-group-item-action">Lịch sử đơn vận chuyển</a>
      </div>
    </div>

    @* <!-- Chuyến xe -->
    <a class="list-group-item list-group-item-action d-flex align-items-center" data-bs-toggle="collapse"
       href="#submenuReceiver" role="button" aria-expanded="false" aria-controls="submenuReceiver">
      <span class="flex-grow-1"><i class="fas fa-map-marked-alt"></i> Chuyến xe</span>
      <span class="text-end"><i class="fas fa-chevron-circle-down"></i></span>
    </a>
    <div class="collapse" id="submenuReceiver">
      <div class="list-group list-group-flush ms-4">
        <a href="/trips" class="list-group-item list-group-item-action">Danh sách phân công chuyến xe</a>
        <a href="/addtrip" class="list-group-item list-group-item-action">Thêm phân công chuyến xe</a>
      </div>
    </div> *@

    <!-- Tài khoản -->
    <a class="list-group-item list-group-item-action d-flex align-items-center" data-bs-toggle="collapse"
       href="#submenuAccount" role="button" aria-expanded="false" aria-controls="submenuAccount">
      <span class="flex-grow-1"><i class="fas fa-cog"></i> Tài khoản</span>
      <span class="text-end"><i class="fas fa-chevron-circle-down"></i></span>
    </a>
    <div class="collapse" id="submenuAccount">
      <div class="list-group list-group-flush ms-4">
        @* <a href="/detailinfo" class="list-group-item list-group-item-action">Thông tin cá nhân</a> *@
        @* <a href="#" class="list-group-item list-group-item-action">Đổi mật khẩu</a> *@
        <a href="" class="list-group-item list-group-item-action" @onclick="HandleLogout">Đăng xuất</a>
      </div>
    </div>

  </div>
</div>



@code {
  private async Task HandleLogout()
  {
    await userServices.Logout();
    navManager.NavigateTo("/");
  }
}

@page "/addwarehouse"


@inject HttpClient Http

@implements IDisposable

@inject UserAdminServices adminServices;

@inject Blazored.LocalStorage.ILocalStorageService localStorage

@inject IJSRuntime JS
@inject NavigationManager navManager



<div class="d-flex flex-column">
    <!-- Navbar luôn hiển thị -->
    <div class="d-block d-lg-none ">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex">
        <!-- Sidebar desktop -->
        <div class="d-none d-lg-block">
            <AdminSidebarLayoutFull />
        </div>

        <!-- Nội dung chính -->
        <div class="container my-5">
            <h2 class="mb-4 text-primary">Thêm mới Kho</h2>

            <EditForm Model="addNewWareHouseViewModel" OnValidSubmit="HandleSubmit" class="p-4 border rounded bg-white shadow-sm">
                <!-- Tên kho -->
                <div class="mb-3">
                    <label for="tenKho" class="form-label">Tên kho</label>
                    <InputText id="tenKho" class="form-control" @bind-Value="addNewWareHouseViewModel.Ten" placeholder="Nhập tên kho" />
                </div>

                <!-- Địa chỉ -->
                <div class="mb-3">
                    <label for="diaChi" class="form-label">Địa chỉ</label>
                    <InputText id="diaChi" class="form-control" @bind-Value="addNewWareHouseViewModel.DiaChi" placeholder="Nhập địa chỉ kho" />
                </div>

                <!-- Dữ liệu mở rộng -->
                <div class="mb-3">
                    <label for="duLieuMoRong" class="form-label">Dữ liệu mở rộng</label>
                    <InputTextArea id="duLieuMoRong" class="form-control" @bind-Value="addNewWareHouseViewModel.DuLieuMoRong" rows="3"
                                placeholder='Ví dụ: {"capacity":1000,"status":"active"}' />
                </div>

                <!-- Vĩ độ -->
                <div class="mb-3">
                    <label for="viDo" class="form-label">Vĩ độ</label>
                    <InputNumber id="viDo" class="form-control" @bind-Value="addNewWareHouseViewModel.ViDo" step="0.000001" />
                </div>

                <!-- Kinh độ -->
                <div class="mb-3">
                    <label for="kinhDo" class="form-label">Kinh độ</label>
                    <InputNumber id="kinhDo" class="form-control" @bind-Value="addNewWareHouseViewModel.KinhDo" step="0.000001" />
                </div>

                <!-- Nút hành động -->
                <div class="d-flex justify-content-end gap-2">
                    <button type="reset" class="btn btn-outline-secondary">Làm mới</button>
                    <button type="submit" class="btn btn-primary">Thêm kho</button>
                </div>
            </EditForm>

            <div class="text-end mt-3">
                <a href="/warehouses" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Thoát
                </a>
            </div>
            
            <!-- Modal Bootstrap -->
            <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title" id="successModalLabel">Thêm kho thành công</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body">
                            <p><strong>Tên kho:</strong> @addNewWareHouseViewModel.Ten</p>
                            <p><strong>Địa chỉ:</strong> @addNewWareHouseViewModel.DiaChi</p>
                            <p><strong>Dữ liệu mở rộng:</strong> @addNewWareHouseViewModel.DuLieuMoRong</p>
                            <p><strong>Vĩ độ:</strong> @addNewWareHouseViewModel.ViDo</p>
                            <p><strong>Kinh độ:</strong> @addNewWareHouseViewModel.KinhDo</p>
                            <p><strong>Ngày tạo:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


@code {
    private AddNewWareHouseViewModel addNewWareHouseViewModel = new AddNewWareHouseViewModel();
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        adminServices.OnChange += StateHasChanged;
        string? token = await localStorage.GetItemAsync<string>("accessToken");
        if (string.IsNullOrEmpty(token))
        {
            // Nếu không có token thì đá về login
            navManager.NavigateTo("/", true);
        }
    }

    private async Task HandleSubmit()
    {
        string? token = await localStorage.GetItemAsync<string>("accessToken");
        var result = await adminServices.AddNewWareHouse(token, addNewWareHouseViewModel);
        if (result) // giả sử service trả về true khi thành công
        {
            // Gọi JS để bật modal Bootstrap
            await JS.InvokeVoidAsync("bootstrapModalShow", "#successModal");
        }
    }    

    public void Dispose()
    {
        // Cleanup nếu cần
        adminServices.OnChange -= StateHasChanged;
    }
}
@page "/addvehicle"



@inject HttpClient Http

@implements IDisposable

@inject UserAdminServices userAdminServices;
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime JS
@inject NavigationManager navManager


<div class="d-flex flex-column">
    <!-- Navbar luôn hiển thị -->
    <div class="d-block d-lg-none ">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex">
        <!-- Sidebar desktop -->
        <div class="d-none d-lg-block">
            <AdminSidebarLayoutFull />
        </div>

        <!-- Nội dung chính -->
        <div class="container my-5">
            <h2 class="mb-4 text-primary">Thêm phương tiện mới</h2>

            <!-- EditForm -->
            <EditForm Model="@addInfo" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="p-4 border rounded bg-white shadow-sm">
                    <!-- Loại phương tiện -->
                    <div class="mb-3">
                        <label for="loai" class="form-label">Loại phương tiện</label>
                        <InputSelect id="loai" class="form-select" @bind-Value="addInfo.Loai">
                            <option value="">-- Chọn loại --</option>
                            <option value="Truck">Truck</option>
                            <option value="Motorbike">Motorbike</option>
                        </InputSelect>
                    </div>

                    <!-- Biển số -->
                    <div class="mb-3">
                        <label for="bienSo" class="form-label">Biển số</label>
                        <InputText id="bienSo" class="form-control" @bind-Value="addInfo.BienSo" placeholder="VD: 51C-123.45" />
                    </div>

                    <!-- Tải trọng tối đa -->
                    <div class="mb-3">
                        <label for="taiTrong" class="form-label">Tải trọng tối đa (kg)</label>
                        <InputNumber id="taiTrong" class="form-control" @bind-Value="addInfo.TaiTrongToiDa" />
                    </div>

                    <!-- Trạng thái -->
                    <div class="mb-3">
                        <label for="trangThai" class="form-label">Trạng thái</label>
                        <InputSelect id="trangThai" class="form-select" @bind-Value="addInfo.TrangThai">
                            <option value="">-- Chọn trạng thái --</option>
                            <option value="Hoạt động">Hoạt động</option>
                            <option value="Ngừng hoạt động">Ngừng hoạt động</option>
                        </InputSelect>
                    </div>

                    <!-- Nút hành động -->
                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-outline-secondary">Làm mới</button>
                        <button type="submit" class="btn btn-primary">Lưu phương tiện</button>
                    </div>
                </div>
            </EditForm>

            <div class="text-end mt-3">
                <a href="/vehicles" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Thoát
                </a>
            </div>

            <!-- Modal Bootstrap -->
            <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title" id="successModalLabel">Thêm phương tiện thành công</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body">
                            <p><strong>Loại:</strong> @addInfo.Loai</p>
                            <p><strong>Biển số:</strong> @addInfo.BienSo</p>
                            <p><strong>Tải trọng tối đa:</strong> @addInfo.TaiTrongToiDa</p>
                            <p><strong>Trạng thái:</strong> @addInfo.TrangThai</p>
                            <p><strong>Ngày tạo:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





@code {
    private AddInfoVehicleViewModel addInfo = new AddInfoVehicleViewModel();
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        userAdminServices.OnChange += StateHasChanged;
        string? token = await localStorage.GetItemAsync<string>("accessToken");
        if (string.IsNullOrEmpty(token))
        {
            // Nếu không có token thì đá về login
            navManager.NavigateTo("/", true);
        }
    }

    private async Task HandleSubmit()
    {
        string? token = await localStorage.GetItemAsync<string>("accessToken");
        var result = await userAdminServices.AddPhuongTien(token, addInfo);
        if (result) // giả sử service trả về true khi thành công
        {
            // Gọi JS để bật modal Bootstrap
            await JS.InvokeVoidAsync("bootstrapModalShow", "#successModal");
        }
    }

    public void Dispose()
    {
        // Cleanup nếu cần
        userAdminServices.OnChange -= StateHasChanged;
    }
}
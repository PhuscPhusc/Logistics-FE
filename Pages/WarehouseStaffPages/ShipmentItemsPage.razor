@page "/shipmentitems"

@inject HttpClient Http
@implements IDisposable

@inject WarehouseStaffServices warehouseStaffServices
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager navManager

<div class="d-flex flex-column min-vh-100 bg-light">

    <!-- Mobile Navbar -->
    <div class="d-block d-lg-none">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex flex-grow-1">

        <!-- Desktop Sidebar -->
        <div class="d-none d-lg-block">
            <WarehouseStaffSidebarLayoutFull />
        </div>

        <!-- Main Content -->
        <div class="container-fluid py-4 px-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1">
                        <i class="fas fa-boxes-stacked text-primary me-2"></i>
                        Kiện hàng trong kho
                    </h3>

                    <p class="text-muted mb-0">
                        Danh sách các kiện hàng hiện đang được lưu trữ trong kho
                    </p>
                </div>

                <button class="btn btn-outline-primary" @onclick="LoadShipmentItems">
                    <i class="fas fa-sync-alt me-1"></i>
                    Làm mới
                </button>
            </div>


            <!-- Thống kê -->
            <div class="row g-3 mb-4">

                <!-- Tổng kiện hàng -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">

                            <div class="bg-primary text-white rounded-circle p-3 me-3">
                                <i class="fas fa-box fa-lg"></i>
                            </div>

                            <div>
                                <p class="text-muted mb-1">
                                    Số kiện hàng
                                </p>

                                <h4 class="fw-bold mb-0">
                                    @(warehouseStaffServices.lstShipmentItemViewModel?.Count ?? 0)
                                </h4>
                            </div>

                        </div>
                    </div>
                </div>


                <!-- Tổng số lượng -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">

                            <div class="bg-success text-white rounded-circle p-3 me-3">
                                <i class="fas fa-cubes fa-lg"></i>
                            </div>

                            <div>
                                <p class="text-muted mb-1">
                                    Tổng số lượng
                                </p>

                                <h4 class="fw-bold mb-0">
                                    @(warehouseStaffServices.lstShipmentItemViewModel?
                                        .Sum(x => x.SoLuong ?? 0) ?? 0)
                                </h4>
                            </div>

                        </div>
                    </div>
                </div>


                <!-- Trạng thái -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">

                            <div class="bg-info text-white rounded-circle p-3 me-3">
                                <i class="fas fa-warehouse fa-lg"></i>
                            </div>

                            <div>
                                <p class="text-muted mb-1">
                                    Trạng thái kho
                                </p>

                                <h5 class="fw-bold mb-0 text-success">
                                    Đang hoạt động
                                </h5>
                            </div>

                        </div>
                    </div>
                </div>

            </div>


            <!-- Bảng kiện hàng -->
            <div class="card border-0 shadow-sm">

                <!-- Card header -->
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="fas fa-list me-2 text-primary"></i>
                        Danh sách kiện hàng
                    </h5>
                </div>


                <!-- Table -->
                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th class="px-4">STT</th>
                                    <th>Mã vận chuyển</th>
                                    <th>Tên hàng</th>
                                    <th class="text-center">Số lượng</th>
                                    <th>Thời gian nhập kho</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (warehouseStaffServices.lstShipmentItemViewModel == null ||
                                     warehouseStaffServices.lstShipmentItemViewModel.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>

                                            <p class="text-muted mb-0">
                                                Hiện tại không có kiện hàng trong kho.
                                            </p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int stt = 1;

                                    @foreach (var item in warehouseStaffServices.lstShipmentItemViewModel)
                                    {
                                        <tr>

                                            <!-- STT -->
                                            <td class="px-4">
                                                @stt
                                            </td>

                                            <!-- Mã vận chuyển -->
                                            <td>
                                                <span class="badge bg-primary">
                                                    @item.MaDonVanChuyen
                                                </span>
                                            </td>

                                            <!-- Tên hàng -->
                                            <td>
                                                <div class="d-flex align-items-center">

                                                    <div class="bg-light rounded p-2 me-2">
                                                        <i class="fas fa-box text-primary"></i>
                                                    </div>

                                                    <span class="fw-semibold">
                                                        @item.TenHang
                                                    </span>

                                                </div>
                                            </td>

                                            <!-- Số lượng -->
                                            <td class="text-center">
                                                <span class="badge bg-success">
                                                    @item.SoLuong
                                                </span>
                                            </td>

                                            <!-- Thời gian nhập -->
                                            <td>
                                                <i class="far fa-clock text-muted me-1"></i>

                                                @(item.ThoiGianNhap?.ToString("dd/MM/yyyy HH:mm")
                                                    ?? "Chưa xác định")
                                            </td>

                                            <!-- Thao tác -->
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye me-1"></i>
                                                    Chi tiết
                                                </button>
                                            </td>

                                        </tr>

                                        stt++;
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer bg-white">

                    <div class="d-flex justify-content-between align-items-center">

                        <span class="text-muted">
                            Tổng số:
                            <strong>
                                @(warehouseStaffServices.lstShipmentItemViewModel?.Count ?? 0)
                            </strong>
                            kiện hàng
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        warehouseStaffServices.OnChange += StateHasChanged;

        string? token =
            await localStorage.GetItemAsync<string>("accessToken");

        if (string.IsNullOrEmpty(token))
        {
            navManager.NavigateTo("/", true);
            return;
        }

        await warehouseStaffServices.GetThongTinKienHangTrongKho(token);
    }


    private async Task LoadShipmentItems()
    {
        string? token =
            await localStorage.GetItemAsync<string>("accessToken");

        if (string.IsNullOrEmpty(token))
        {
            navManager.NavigateTo("/", true);
            return;
        }

        await warehouseStaffServices.GetThongTinKienHangTrongKho(token);
    }


    public void Dispose()
    {
        warehouseStaffServices.OnChange -= StateHasChanged;
    }
}
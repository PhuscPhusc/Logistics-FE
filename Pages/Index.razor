@* TRANG ĐĂNG NHẬP *@
@page "/"
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt

@* Gọi footer dùng chung cho login và register *@
@layout HeaderFooter

@* Tiêm Services *@
@inject UserAdminServices userServices;

@* Lấy token từ local, parse token *@
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager navManager
@inject CustomAuthStateProvider AuthProvider


@implements IDisposable
<div class="">
    <!-- Login Box -->
    <div class="container d-flex justify-content-center align-items-center mt-4">
        <div class="card shadow-sm p-4" style="max-width: 500px; width: 100%;">
            <h5 class="text-center mb-4">Đăng nhập</h5>
            <EditForm Model="@userLogin" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="username" class="form-label">Tên đăng nhập/Số điện thoại/Email</label>
                    <InputText id="username" class="form-control" @bind-Value="userLogin.tenDangNhapOrEmail" type="text"
                               placeholder="Nhập tên đăng nhập hoặc số điện thoại hoặc email" required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <InputText id="password" class="form-control" @bind-Value="userLogin.matKhau" type="password"
                               placeholder="Nhập mật khẩu" required />
                </div>

                <button type="submit" class="btn btn-danger w-100">ĐĂNG NHẬP</button>
            </EditForm>
            <div class="d-flex justify-content-end mt-3">
                <a href="#" class="text-danger fw-bold">Quên mật khẩu?</a>
            </div>
            <div class="d-flex justify-content-center mt-3">
                <span>
                    Bạn chưa có tài khoản?
                    <a href="/register" class="text-primary fw-bold">Đăng ký ngay</a>
                </span>
            </div>
        </div>
    </div>
</div>




@code {
    // Khởi tạo ở đây vì đợi giao diện hiển thị hoàn chỉnh mới cho phép dùng
    private UserLoginViewModel userLogin = new UserLoginViewModel();

    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        userServices.OnChange += StateHasChanged;
        // Nếu chưa ở trang login thì redirect
        if (!navManager.Uri.EndsWith("/"))
        {
            navManager.NavigateTo("/", true);
        }
    }

    // Phương thức submit gắn vào btn submit
    private async Task HandleSubmit()
    {
        userServices.userLoginViewModel = userLogin;
        var token = await userServices.Login();
        if (!string.IsNullOrEmpty(token))
        {
            var jwt = new JwtSecurityTokenHandler().ReadJwtToken(token);
            var roles = jwt.Claims
                .Where(c => c.Type == ClaimTypes.Role || c.Type == "role")
                .Select(c => c.Value.Trim())
                .ToList();


            if (roles.Any(r => r.Equals("System_Admin", StringComparison.OrdinalIgnoreCase)))
            {
                navManager.NavigateTo("/adminhomepage", forceLoad: true);
            }
            else if (roles.Any(r => r.Equals("Warehouse_Staff", StringComparison.OrdinalIgnoreCase)))
            {
                navManager.NavigateTo("/detailinfowarehousestaff", forceLoad: true);
            }
            else if (roles.Any(r => r.Equals("Customer", StringComparison.OrdinalIgnoreCase)))
            {
                navManager.NavigateTo("/customerhomepage");
            }
            else if (roles.Any(r => r.Equals("Operation_Staff", StringComparison.OrdinalIgnoreCase)))
            {
                navManager.NavigateTo("/operationstaffdetailinfo");
            }
            else if (roles.Any(r => r.Equals("Delivery_Staff", StringComparison.OrdinalIgnoreCase)))
            {
                navManager.NavigateTo("/deliverystaffdetailinfo");
            }
            else
            {
                // fallback nếu không khớp role nào
                navManager.NavigateTo("/homepage");
            }

        }

    }
    public void Dispose()
    {
        // Cleanup nếu cần
        userServices.OnChange -= StateHasChanged;
    }
}



@* GHI CHÚ LỖI VỀ ROLE *@
@*
Lỗi về role trong JWT
Nguyên nhân: Claim type trong token không thống nhất.

Có lúc backend phát hành role với type "http://schemas.microsoft.com/ws/2008/06/identity/claims/role" (tương ứng
ClaimTypes.Role).

Có lúc lại phát hành với type "role".

Khi chỉ lọc bằng ClaimTypes.Role, bạn sẽ bỏ sót những claim có type "role" → dẫn đến không tìm thấy "System_Admin" dù
token có.

Cách check
Luôn in toàn bộ claim để xem type thực tế:

csharp
foreach (var claim in jwt.Claims)
{
    Console.WriteLine($"{claim.Type} = {claim.Value}");
}
Cách fix
Lọc cả hai loại type:

csharp
var roles = jwt.Claims
               .Where(c => c.Type == ClaimTypes.Role || c.Type == "role")
               .Select(c => c.Value.Trim())
               .ToList();
So sánh role bằng Equals(..., OrdinalIgnoreCase) để tránh lỗi hoa thường hoặc khoảng trắng:

csharp
if (roles.Any(r => r.Equals("System_Admin", StringComparison.OrdinalIgnoreCase)))
{
    navManager.NavigateTo("/adminhomepage");
}
*@

@*
Để biết backend phát hành role với type gì, bạn có thể kiểm tra trực tiếp trong JWT sau khi decode:

Cách check
In toàn bộ claim sau khi parse token:

csharp
foreach (var claim in jwt.Claims)
{
    Console.WriteLine($"{claim.Type} = {claim.Value}");
}
→ Kết quả sẽ cho bạn thấy rõ claim type thực tế là "role" hay
"http://schemas.microsoft.com/ws/2008/06/identity/claims/role".

Dùng JWT debugger (ví dụ jwt.io) để paste token vào.
→ Trong phần payload sẽ hiện rõ key "role" hoặc "http://schemas.microsoft.com/ws/2008/06/identity/claims/role".

Xem code backend:

Nếu backend tạo claim bằng new Claim(ClaimTypes.Role, "System_Admin") → type sẽ là chuỗi dài
"http://schemas.microsoft.com/ws/2008/06/identity/claims/role".

Nếu backend tạo claim bằng new Claim("role", "System_Admin") → type sẽ là "role".
*@
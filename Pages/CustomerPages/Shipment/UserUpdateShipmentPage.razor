@page "/updateshipment/{id:guid}"



@inject HttpClient Http

@implements IDisposable

@inject UserServices userServices
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager navManager




<div class="d-flex flex-column">
    <div class="d-block d-lg-none ">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex">
        <div class="d-none d-lg-block">
            <CustomerSidebarLayoutFull />
        </div>

        <!-- Nội dung chính -->
        <div class="container py-5"> <!-- ================= HEADER ================= -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold text-primary mb-1"> Cập nhật đơn vận chuyển </h2>
                    <p class="text-muted mb-0"> Mã vận chuyển: <span class="fw-bold text-dark">VC20260916001</span> </p>
                </div> <span class="badge bg-warning text-dark fs-6 px-3 py-2"> Đang tạo </span>
            </div> <!-- ================= FORM ================= -->
            <EditForm Model="viewModel" OnValidSubmit="HandleUpdate">

                <!-- ================= THÔNG TIN NGƯỜI GỬI ================= -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Thông tin người gửi</h5>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Tên người gửi
                                </label>

                                <InputText class="form-control" @bind-Value="viewModel.TenNguoiGui"
                                           placeholder="Nhập tên người gửi" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Địa chỉ người gửi
                                </label>

                                <InputText class="form-control" @bind-Value="viewModel.DiaChiNguoiGui"
                                           placeholder="Nhập địa chỉ người gửi" />
                            </div>

                        </div>
                    </div>
                </div>


                <!-- ================= THÔNG TIN NGƯỜI NHẬN ================= -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Thông tin người nhận</h5>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Tên người nhận
                                </label>

                                <InputText class="form-control" @bind-Value="viewModel.TenNguoiNhan"
                                           placeholder="Nhập tên người nhận" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Số điện thoại người nhận
                                </label>

                                <InputText class="form-control" @bind-Value="viewModel.SoDienThoaiNguoiNhan"
                                           placeholder="Nhập số điện thoại" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Địa chỉ người nhận
                                </label>

                                <InputText class="form-control" @bind-Value="viewModel.DiaChiNguoiNhan"
                                           placeholder="Nhập địa chỉ người nhận" />
                            </div>

                        </div>
                    </div>
                </div>


                <!-- ================= THÔNG TIN VẬN CHUYỂN ================= -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Thông tin vận chuyển</h5>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Tổng quãng đường
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control" @bind-Value="viewModel.TongQuangDuong" min="0"
                                                 step="0.1" />

                                    <span class="input-group-text">
                                        Km
                                    </span>

                                </div>

                                <div class="form-text">
                                    Thay đổi quãng đường có thể làm thay đổi phí vận chuyển.
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Dữ liệu mở rộng
                                </label>

                                <InputText class="form-control" @bind-Value="viewModel.DuLieuMoRong"
                                           placeholder="Nhập dữ liệu mở rộng" />
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ================= DANH SÁCH KIỆN HÀNG ================= -->
                <div class="card shadow-sm mb-4">

                    <div class="card-header bg-warning">
                        <div class="d-flex justify-content-between align-items-center">

                            <h5 class="mb-0">
                                Danh sách kiện hàng
                            </h5>

                            <span class="badge bg-dark">
                                @viewModel.dsKienHangUpdate.Count kiện hàng
                            </span>

                        </div>
                    </div>

                    <div class="card-body">
                        @foreach (var (kh, index) in viewModel.dsKienHangUpdate
                            .Select((value, index) => (value, index)))
                        {
                            <div class="card border mb-3">

                                <div class="card-header bg-light">
                                    <div class="d-flex justify-content-between align-items-center">

                                        <strong>
                                            Kiện hàng #@(index + 1)
                                        </strong>

                                        

                                    </div>
                                </div>

                                <div class="card-body">
                                    <!-- ID kiện hàng -->
                                    <input type="hidden" @bind="kh.Id" />
                                    <div class="row g-3">

                                        <!-- Tên hàng -->
                                        <div class="col-md-6">

                                            <label class="form-label fw-semibold">
                                                Tên hàng
                                            </label>

                                            <InputText class="form-control" @bind-Value="kh.TenHang"
                                                       placeholder="Nhập tên hàng" />

                                        </div>

                                        <!-- Khối lượng -->
                                        <div class="col-md-6">

                                            <label class="form-label fw-semibold">
                                                Khối lượng
                                            </label>

                                            <div class="input-group">

                                                <InputNumber class="form-control" @bind-Value="kh.KhoiLuong" min="0"
                                                             step="0.01" />

                                                <span class="input-group-text">
                                                    Kg
                                                </span>

                                            </div>

                                        </div>

                                        <!-- Mô tả -->
                                        <div class="col-12">

                                            <label class="form-label fw-semibold">
                                                Mô tả
                                            </label>

                                            <InputTextArea class="form-control" @bind-Value="kh.MoTa" rows="3"
                                                           placeholder="Nhập mô tả hàng hóa" />

                                        </div>

                                        <!-- Ghi chú -->
                                        <div class="col-12">

                                            <label class="form-label fw-semibold">
                                                Ghi chú
                                            </label>

                                            <InputTextArea class="form-control" @bind-Value="kh.GhiChu" rows="2"
                                                           placeholder="Nhập ghi chú" />

                                        </div>

                                    </div>

                                </div>
                            </div>
                        }


                        
                    </div>
                </div>


                <!-- ================= ACTION ================= -->
                <div class="d-flex justify-content-end gap-2">

                    <button type="button" class="btn btn-secondary px-4" @onclick="Cancel">
                        Hủy
                    </button>

                    <button type="submit" class="btn btn-primary px-4">
                        Cập nhật đơn vận chuyển
                    </button>

                    <button type="button" class="btn btn-secondary" @onclick="GoBack">
                        <i class="bi bi-arrow-left-circle"></i>
                        Quay lại
                    </button>

                </div>

            </EditForm>
        </div>
    </div>

</div>





@code {
    [Parameter]
    public Guid id { get; set; }
    private UpdateShipmentViewModel viewModel = new UpdateShipmentViewModel();
    protected override async Task OnInitializedAsync()
    {
        userServices.OnChange += StateHasChanged;

        string? token = await localStorage.GetItemAsync<string>("accessToken");

        if (string.IsNullOrEmpty(token))
        {
            navManager.NavigateTo("/", true);
            return;
        }

        var maDonVanChuyen = userServices.shipmentInfoViewModels
            .FirstOrDefault(u => u.Id == id)?.MaVanChuyen;

        if (maDonVanChuyen == null)
        {
            return;
        }

        // Gọi GetDetail
        await userServices.GetDonVanChuyenDetail(token, maDonVanChuyen);

        var shipment = userServices.shipmentDetailInfoView;

        if (shipment == null)
        {
            return;
        }

        // =========================
        // MAP THÔNG TIN ĐƠN
        // =========================

        viewModel.TenNguoiGui = shipment.TenNguoiGui;
        viewModel.DiaChiNguoiGui = shipment.DiaChiNguoiGui;

        viewModel.TenNguoiNhan = shipment.TenNguoiNhan;
        viewModel.DiaChiNguoiNhan = shipment.DiaChiNguoiNhan;
        viewModel.SoDienThoaiNguoiNhan = shipment.SoDienThoaiNguoiNhan;

        viewModel.TongQuangDuong = shipment.QuangDuong;

        viewModel.NgayTao = shipment.NgayTao;

        // Nếu chưa có dữ liệu mở rộng từ API
        viewModel.DuLieuMoRong = "";

        // =========================
        // MAP DANH SÁCH KIỆN HÀNG
        // =========================

        viewModel.dsKienHangUpdate = shipment.dsKienHang
            .Select(kh => new UpdateKienHangDTO
            {
                // Quan trọng:
                // GetDetail hiện tại không trả Id của kiện hàng
                Id = kh.Id,

                TenHang = kh.TenHang,
                MoTa = kh.MoTa,
                KhoiLuong = kh.KhoiLuong,
                GhiChu = kh.GhiChu
            })
            .ToList();
    }

    private async Task HandleUpdate()
    {
        string? token = await localStorage.GetItemAsync<string>("accessToken");

        if (string.IsNullOrEmpty(token))
        {
            navManager.NavigateTo("/", true);
            return;
        }

        var maDonVanChuyen = userServices.shipmentInfoViewModels
            .FirstOrDefault(u => u.Id == id)?.MaVanChuyen;

        if (string.IsNullOrEmpty(maDonVanChuyen))
        {
            return;
        }

        bool result = await userServices.UpdateDonVanChuyen(
            token,
            maDonVanChuyen,
            viewModel
        );

        if (result)
        {
            navManager.NavigateTo("/shipment");
        }
    }



    private void Cancel()
    {
        navManager.NavigateTo("/shipment");
    }

    private void GoBack()
    {
        navManager.NavigateTo("/shipment");
    }


    public void Dispose()
    {
        // Cleanup nếu cần
        userServices.OnChange -= StateHasChanged;
    }
}
@page "/shipment"

@inject HttpClient Http

@implements IDisposable

@inject UserServices userServices
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager navManager

<div class="d-flex flex-column">
    <div class="d-block d-lg-none ">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex">
        <div class="d-none d-lg-block">
            <CustomerSidebarLayoutFull />
        </div>

        <!-- Nội dung chính -->
        <div class="container my-5">
            <h2 class="mb-4 text-primary">Danh sách đơn vận chuyển</h2>

            @if (userServices.shipmentInfoViewModels == null || !userServices.shipmentInfoViewModels.Any())
            {
                <p>Không có đơn vận chuyển nào.</p>
            }
            else
            {
                @foreach (var shipment in userServices.shipmentInfoViewModels)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-info text-white fw-bold">
                            Mã vận chuyển: @shipment.MaVanChuyen
                            <span
                                class="badge @(shipment.TrangThai == "Hoàn thành" ? "bg-success" : "bg-warning text-dark") ms-2">
                                @shipment.TrangThai
                            </span>
                        </div>
                        <div class="card-body">
                            <p><strong>Người gửi:</strong> @shipment.TenNguoiGui - @shipment.DiaChiNguoiGui</p>
                            <p><strong>Người nhận:</strong> @shipment.TenNguoiNhan - @shipment.DiaChiNguoiNhan</p>
                            <p><strong>SĐT người nhận:</strong> @shipment.SoDienThoaiNguoiNhan</p>
                            <p><strong>Tổng khối lượng:</strong> @shipment.TongKhoiLuong kg</p>
                            <p><strong>Tổng thể tích:</strong> @shipment.TongTheTich m³</p>
                            <p><strong>Tổng tiền:</strong> @shipment.TongTien VNĐ</p>
                            <p><strong>Quãng đường:</strong> @shipment.QuangDuong km</p>
                            <p><strong>Ngày tạo:</strong> @shipment.NgayTao?.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="card-footer bg-light">
                            <h6 class="fw-bold">Danh sách kiện hàng</h6>
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tên hàng</th>
                                        <th>Mô tả</th>
                                        <th>Khối lượng</th>
                                        <th>Thể tích</th>
                                        <th>Loại hàng hóa</th>
                                        <th>Tổng tiền</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kh in shipment.dsKienHang)
                                    {
                                        <tr>
                                            <td>@kh.TenHang</td>
                                            <td>@kh.MoTa</td>
                                            <td>@kh.KhoiLuong kg</td>
                                            <td>@kh.TheTich m³</td>
                                            <td>@kh.LoaiHangHoa</td>
                                            <td>@kh.TongTien VNĐ</td>
                                            <td>@kh.GhiChu</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end gap-2 p-3">
                            <!-- Xem chi tiết -->
                            <NavLink href="@($"/shipmentdetail/{shipment.Id}")" class="btn btn-outline-info">
                                <i class="fas fa-eye me-1"></i>
                                Xem chi tiết
                            </NavLink>

                            <!-- Cập nhật -->
                            <NavLink href="@($"/updateshipment/{shipment.Id}")" class="btn btn-outline-primary">
                                <i class="fas fa-edit me-1"></i>
                                Cập nhật đơn vận chuyển
                            </NavLink>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        userServices.OnChange += StateHasChanged;
        string? token = await localStorage.GetItemAsync<string>("accessToken");
        if (string.IsNullOrEmpty(token))
        {
            navManager.NavigateTo("/", true);
            return;
        }

        await userServices.GetDonVanChuyenTheoUserId(token);
    }

    public void Dispose()
    {
        userServices.OnChange -= StateHasChanged;
    }
}

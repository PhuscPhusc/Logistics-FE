@page "/customerhomepage"


@inject HttpClient Http

@implements IDisposable
@inject UserServices userServices;
@inject Blazored.LocalStorage.ILocalStorageService localStorage;

@inject NavigationManager navManager

<div class="d-flex flex-column">
    <!-- Navbar luôn hiển thị -->
    <div class="d-block d-lg-none ">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex">
        <!-- Sidebar desktop -->
        <div class="d-none d-lg-block">
            <CustomerSidebarLayoutFull />
        </div>


        <!-- Nội dung chính -->
        <div class="container my-5">
            <h2 class="mb-4 text-primary">Thông tin hồ sơ người dùng</h2>

            <!-- Card hồ sơ -->
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <!-- Ảnh đại diện -->
                    <img src="https://via.placeholder.com/120" alt="Ảnh đại diện" class="rounded-circle me-4"
                         style="width:120px;height:120px;object-fit:cover;">
                    <!-- Thông tin cơ bản -->
                    <div>
                        <h4 class="card-title mb-1">@userServices.detailInfoProfile.HoTen</h4>
                        @* <p class="mb-1"><strong>Id:</strong> @userServices.detailInfoProfile.Id</p> *@
                        <p class="mb-1"><strong>Họ tên:</strong> @userServices.detailInfoProfile.HoTen</p>
                        <p class="mb-1"><strong>Tên đăng nhập:</strong> @userServices.detailInfoProfile.TenDangNhap</p>
                        <p class="mb-1"><strong>Email:</strong> @userServices.detailInfoProfile.Email</p>
                        <p class="mb-1"><strong>Số điện thoại:</strong> @userServices.detailInfoProfile.SoDienThoai</p>
                        <p class="mb-1"><strong>Địa chỉ chính:</strong> @userServices.detailInfoProfile.DiaChi</p>
                    </div>
                </div>
                <!-- NavLink chỉnh sửa -->
                <div>
                    <NavLink href="@($"/customerupdate/{userServices.detailInfoProfile.Id}")"
                             class="btn btn-outline-primary">
                        <i class="fas fa-edit"></i> Chỉnh sửa
                    </NavLink>
                </div>

            </div>

            <!-- Danh sách địa chỉ khác -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-danger text-dark fw-bold">
                    Địa chỉ khác
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Địa chỉ chi tiết</th>
                                <th scope="col">Phường</th>
                                <th scope="col">Quận</th>
                                <th scope="col">Thành phố</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var diaChiKhac in userServices.detailInfoProfile.DiaChiKhacs)
                            {
                                <!-- Ví dụ dữ liệu mẫu -->
                                <tr>
                                    <td>@diaChiKhac.DiaChiChiTiet</td>
                                    <td>@diaChiKhac.Phuong</td>
                                    <td>@diaChiKhac.Quan</td>
                                    <td>@diaChiKhac.ThanhPho</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        userServices.OnChange += StateHasChanged;
        string? token = await localStorage.GetItemAsync<string>("accessToken");
        if (string.IsNullOrEmpty(token))
        {
            // Nếu không có token thì đá về login
            navManager.NavigateTo("/", true);
        }
        await userServices.GetUserDetailProfile(token);
    }



    public void Dispose()
    {
        // Cleanup nếu cần
        userServices.OnChange -= StateHasChanged;
    }
}
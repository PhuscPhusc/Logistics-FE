@page "/deliverystaffdetailinfo"
@inject HttpClient Http

@implements IDisposable

@inject DeliveryStaffServices deliveryStaffServices
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager navManager

<div class="d-flex flex-column">

    <!-- Navbar mobile -->
    <div class="d-block d-lg-none">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex">

        <!-- Sidebar desktop -->
        <div class="d-none d-lg-block">
            <DeliveryStaffSidebarLayoutFull />
        </div>

        <!-- Nội dung chính -->
        <div class="container-fluid py-4">

            <!-- HEADER -->
            <div class="mb-4">
                <h4 class="fw-bold mb-1">
                    <i class="fas fa-user-cog me-2"></i>
                    Thông tin nhân viên giao hàng
                </h4>

                <p class="text-muted mb-0">
                    Thông tin cá nhân và phương tiện được phân công
                </p>
            </div>


            <!-- THÔNG TIN NHÂN VIÊN -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-user me-2 text-primary"></i>
                        Thông tin cá nhân
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <!-- AVATAR -->
                        <div class="col-lg-3 text-center">

                            <div class="mb-3">

                                @if (!string.IsNullOrWhiteSpace(
                                    deliveryStaffServices.infoDeliveryStaffViewModel?.AnhDaiDien))
                                {
                                    <img src="@deliveryStaffServices.infoDeliveryStaffViewModel.AnhDaiDien"
                                         class="rounded-circle img-thumbnail"
                                         style="width: 150px; height: 150px; object-fit: cover;" alt="Ảnh đại diện">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto"
                                         style="width: 150px; height: 150px;">

                                        <i class="fas fa-user text-secondary" style="font-size: 60px;">
                                        </i>

                                    </div>
                                }

                            </div>

                            <h5 class="fw-bold mb-1">
                                @(deliveryStaffServices.infoDeliveryStaffViewModel?.HoTen
                                    ?? "Chưa cập nhật")
                            </h5>

                            <span class="badge bg-success">
                                Nhân viên giao hàng
                            </span>

                        </div>


                        <!-- THÔNG TIN -->
                        <div class="col-lg-9">

                            <div class="row g-3">

                                <!-- TÊN ĐĂNG NHẬP -->
                                <div class="col-md-6">

                                    <label class="form-label text-muted mb-1">
                                        Tên đăng nhập
                                    </label>

                                    <div class="form-control bg-light">
                                        @(deliveryStaffServices.infoDeliveryStaffViewModel?.TenDangNhap
                                            ?? "Chưa cập nhật")
                                    </div>

                                </div>


                                <!-- HỌ TÊN -->
                                <div class="col-md-6">

                                    <label class="form-label text-muted mb-1">
                                        Họ và tên
                                    </label>

                                    <div class="form-control bg-light">
                                        @(deliveryStaffServices.infoDeliveryStaffViewModel?.HoTen
                                            ?? "Chưa cập nhật")
                                    </div>

                                </div>


                                <!-- EMAIL -->
                                <div class="col-md-6">

                                    <label class="form-label text-muted mb-1">
                                        Email
                                    </label>

                                    <div class="form-control bg-light">
                                        @(deliveryStaffServices.infoDeliveryStaffViewModel?.Email
                                            ?? "Chưa cập nhật")
                                    </div>

                                </div>


                                <!-- SỐ ĐIỆN THOẠI -->
                                <div class="col-md-6">

                                    <label class="form-label text-muted mb-1">
                                        Số điện thoại
                                    </label>

                                    <div class="form-control bg-light">
                                        @(deliveryStaffServices.infoDeliveryStaffViewModel?.SoDienThoai
                                            ?? "Chưa cập nhật")
                                    </div>

                                </div>


                                <!-- SỐ GIẤY PHÉP -->
                                <div class="col-md-6">

                                    <label class="form-label text-muted mb-1">
                                        Số giấy phép
                                    </label>

                                    <div class="form-control bg-light">
                                        @(deliveryStaffServices.infoDeliveryStaffViewModel?.SoGiayPhep
                                            ?? "Chưa cập nhật")
                                    </div>

                                </div>


                                <!-- ĐỊA CHỈ -->
                                <div class="col-md-6">

                                    <label class="form-label text-muted mb-1">
                                        Địa chỉ
                                    </label>

                                    <div class="form-control bg-light">
                                        @(deliveryStaffServices.infoDeliveryStaffViewModel?.DiaChi
                                            ?? "Chưa cập nhật")
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- THÔNG TIN PHƯƠNG TIỆN -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-motorcycle me-2 text-primary"></i>
                        Thông tin phương tiện
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <!-- LOẠI PHƯƠNG TIỆN -->
                        <div class="col-md-6">

                            <div class="border rounded p-4 h-100">

                                <div class="d-flex align-items-center mb-3">

                                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                        <i class="fas fa-motorcycle text-primary fs-4"></i>
                                    </div>

                                    <div>

                                        <div class="text-muted small">
                                            Loại phương tiện
                                        </div>

                                        <div class="fw-bold fs-5">
                                            @(deliveryStaffServices.infoDeliveryStaffViewModel?
                                                .infoChuyenXe?.Loai
                                                ?? "Chưa cập nhật")
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- BIỂN SỐ -->
                        <div class="col-md-6">

                            <div class="border rounded p-4 h-100">

                                <div class="d-flex align-items-center mb-3">

                                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                                        <i class="fas fa-id-card text-success fs-4"></i>
                                    </div>

                                    <div>

                                        <div class="text-muted small">
                                            Biển số xe
                                        </div>

                                        <div class="fw-bold fs-5">
                                            @(deliveryStaffServices.infoDeliveryStaffViewModel?
                                                .infoChuyenXe?.BienSo
                                                ?? "Chưa cập nhật")
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        deliveryStaffServices.OnChange += StateHasChanged;

        string? token =
            await localStorage.GetItemAsync<string>("accessToken");

        if (string.IsNullOrEmpty(token))
        {
            navManager.NavigateTo("/", true);
            return;
        }

        await deliveryStaffServices.GetInfoDeliveryStaffAndInfoVehicle(token);
            
    }


    public void Dispose()
    {
        deliveryStaffServices.OnChange -= StateHasChanged;
    }

}


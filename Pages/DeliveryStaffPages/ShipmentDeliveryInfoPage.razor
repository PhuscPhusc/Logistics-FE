@page "/shipmentdeliveryinfo"
@inject HttpClient Http

@implements IDisposable

@inject DeliveryStaffServices deliveryStaffServices
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager navManager



<div class="d-flex flex-column">
    <!-- Navbar luôn hiển thị -->
    <div class="d-block d-lg-none ">
        <AdminNavbarLayout />
    </div>

    <div class="d-flex">
        <!-- Sidebar desktop -->
        <div class="d-none d-lg-block">
            <DeliveryStaffSidebarLayoutFull />
        </div>

        <!-- Nội dung chính -->
        <div class="container-fluid py-4">

            <!-- Tiêu đề -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1">
                        <i class="fas fa-truck me-2"></i>
                        Đơn vận chuyển trong giao hàng
                    </h4>

                    <p class="text-muted mb-0">
                        Danh sách các đơn vận chuyển được phân công cho tài xế
                    </p>
                </div>

                <button type="button" class="btn btn-outline-primary">
                    <i class="fas fa-sync-alt me-1"></i>
                    Làm mới
                </button>
            </div>

           
            <!-- Thông tin tổng quan -->
            <div class="row g-3 mb-4">

                <!-- Tổng đơn -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">

                            <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                <i class="fas fa-box text-primary fs-4"></i>
                            </div>

                            <div>
                                <div class="text-muted small">
                                    Tổng đơn vận chuyển
                                </div>

                                <h4 class="fw-bold mb-0">
                                    @(deliveryStaffServices.infoShipmentDeliveryViewModels?.Count ?? 0)
                                </h4>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Đang giao -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">

                            <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                                <i class="fas fa-map-marker-alt text-success fs-4"></i>
                            </div>

                            <div>
                                <div class="text-muted small">
                                    Đang giao
                                </div>

                                <h4 class="fw-bold mb-0">
                                    -
                                </h4>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Chờ giao -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">

                            <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                                <i class="fas fa-clock text-warning fs-4"></i>
                            </div>

                            <div>
                                <div class="text-muted small">
                                    Chờ giao
                                </div>

                                <h4 class="fw-bold mb-0">
                                    -
                                </h4>
                            </div>

                        </div>
                    </div>
                </div>

            </div>


            <!-- Danh sách đơn vận chuyển -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Danh sách đơn vận chuyển
                            </h5>

                            <span class="text-muted small">
                                Các đơn vận chuyển được phân công cho bạn
                            </span>
                        </div>

                    </div>
                </div>

                <div class="card-body p-0">

                    @if (deliveryStaffServices.infoShipmentDeliveryViewModels == null ||
                         !deliveryStaffServices.infoShipmentDeliveryViewModels.Any())
                    {
                        <div class="text-center py-5">

                            <i class="fas fa-box-open text-muted fs-1 mb-3"></i>

                            <h6 class="fw-semibold">
                                Chưa có đơn vận chuyển
                            </h6>

                            <p class="text-muted mb-0">
                                Hiện tại chưa có đơn vận chuyển nào được phân công cho bạn.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>

                                        <th class="ps-4" style="width: 70px;">
                                            STT
                                        </th>

                                        <th>
                                            Mã vận chuyển
                                        </th>

                                        <th>
                                            Địa chỉ người nhận
                                        </th>

                                        <th>
                                            Số điện thoại
                                        </th>

                                        <th class="text-center">
                                            Thao tác
                                        </th>

                                    </tr>
                                </thead>

                                <tbody>

                                    @{
                                        int stt = 1;
                                    }

                                    @foreach (var item in deliveryStaffServices.infoShipmentDeliveryViewModels)
                                    {
                                        <tr>

                                            <td class="ps-4">
                                                @stt
                                            </td>

                                            <td>
                                                <span class="fw-semibold text-primary">
                                                    @item.MaVanChuyen
                                                </span>
                                            </td>

                                            <td>
                                                @item.DiaChiNguoiNhan
                                            </td>

                                            <td>
                                                @item.SoDienThoaiNguoiNhan
                                            </td>

                                            <td class="text-center">

                                                <button type="button" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye me-1"></i>
                                                    Xem
                                                </button>

                                            </td>

                                        </tr>

                                        stt++;
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>
            

        </div>
    </div>
</div>






@code {
    protected override async Task OnInitializedAsync()
    {
        // Gọi API ở đây nếu cần
        // var data = await Http.GetFromJsonAsync<T>("/api/endpoint");

        // Nếu có dùng state service:
        deliveryStaffServices.OnChange += StateHasChanged;
        string? token =
            await localStorage.GetItemAsync<string>("accessToken");

        if (string.IsNullOrEmpty(token))
        {
            navManager.NavigateTo("/", true);
            return;
        }

        await deliveryStaffServices.GetInfoShipmentInDelivery(token);
    }

    

    public void Dispose()
    {
        // Cleanup nếu cần
        deliveryStaffServices.OnChange -= StateHasChanged;
    }
}